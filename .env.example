OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local data paths
DATABASE_PATH=/workspace/data/sessions.db
NEJM_PATTERNS_PATH=/workspace/data/nejm_case_discussions.json

# Optional Twilio request validation (recommended for production)
VERIFY_TWILIO_SIGNATURE=false
TWILIO_AUTH_TOKEN=

# Tuning
MAX_CONTEXT_MESSAGES=16
MAX_KNOWLEDGE_SNIPPETS=3
